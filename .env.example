# Environment variables declared in this file are automatically made available to Prisma and Next.js.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Local MariaDB / MySQL Connection URL for Zealand Labs (matches docker-compose.yml or VM MySQL service)
DATABASE_URL="mysql://zealand_admin:local_admin_secure@127.0.0.1:3306/zealand_labs"

# Cryptographically signed HMAC session secret (Required in production)
# Generate with: openssl rand -base64 32
SESSION_SECRET="zealand-labs-hmac-sha256-production-session-secret-change-me-in-production"

# NextAuth Configuration (Admin only, local zero-cloud)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="local-development-secret-zealand-labs-2026"
