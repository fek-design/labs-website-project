generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum HardwareType {
  STATIC_MACHINE
  BORROWABLE_GEAR
}

enum OperationalStatus {
  AVAILABLE
  MAINTENANCE
  BROKEN
}

enum LabModule {
  CAPABILITY_BENTO
  EQUIPMENT_POS
  MANUAL_VIEWER
}

enum TagCategory {
  USE_CASE
  STUDY_PATH
  MATERIAL
}

model Lab {
  id          Int         @id @default(autoincrement())
  slug        String      @unique
  name        String
  description String      @db.Text
  module      LabModule
  inventory   Inventory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([slug])
}

model Inventory {
  id                Int                @id @default(autoincrement())
  labId             Int
  assetTag          String             @unique
  name              String
  hardwareType      HardwareType
  operationalStatus OperationalStatus?
  isOnLoan          Boolean            @default(false)
  lab               Lab                @relation(fields: [labId], references: [id], onDelete: Cascade)
  tags              InventoryTag[]
  loans             Loan[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([assetTag])
  @@index([labId])
}

model Tag {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  category  TagCategory
  inventory InventoryTag[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model InventoryTag {
  inventoryId Int
  tagId       Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([inventoryId, tagId])
}

model Patron {
  id        Int      @id @default(autoincrement())
  studentId String   @unique
  name      String?
  loans     Loan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model Loan {
  id          Int       @id @default(autoincrement())
  inventoryId Int
  patronId    Int
  checkedOutAt DateTime @default(now())
  returnedAt  DateTime?
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  patron      Patron    @relation(fields: [patronId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([inventoryId])
  @@index([patronId])
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
